[Unit]
Description=Forgejo
After=network-online.target forgejo-bootstrap.service
Wants=network-online.target
Requires=forgejo-bootstrap.service

[Service]
User=forgejo
Group=forgejo
WorkingDirectory=/srv/data/forgejo
Environment=HOME=/srv/data/forgejo USER=forgejo FORGEJO_WORK_DIR=/srv/data/forgejo
ExecStart=/usr/local/bin/forgejo web --config /etc/forgejo/app.ini
Restart=always
RestartSec=2
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
