#!/bin/sh
# Render NetBird's combined-server config from its credentials, every boot.
# The store encryption key must never change for an existing data disk; the
# host keeps it (secrets/netbird/) and delivers the same value each time.
set -eu
c="$CREDENTIALS_DIRECTORY"
install -d -m 0711 /srv/data/docker
install -d -m 0700 /srv/data/netbird /run/netbird
umask 077
cat > /run/netbird/config.yaml <<YAML
server:
  listenAddress: ":80"
  exposedAddress: "https://netbird.hitkit.internal:443"
  stunPorts:
    - 3478
  metricsPort: 9090
  healthcheckAddress: ":9000"
  logLevel: "info"
  logFile: "console"
  disableAnonymousMetrics: true
  authSecret: "$(cat "$c/hitkit.nb.relay-secret")"
  dataDir: "/var/lib/netbird"
  auth:
    issuer: "https://netbird.hitkit.internal/oauth2"
    signKeyRefreshEnabled: true
    sessionCookieEncryptionKey: "$(cat "$c/hitkit.nb.cookie-key")"
    dashboardRedirectURIs:
      - "https://netbird.hitkit.internal/nb-auth"
      - "https://netbird.hitkit.internal/nb-silent-auth"
    cliRedirectURIs:
      - "http://localhost:53000/"
  reverseProxy:
    trustedHTTPProxies:
      - "172.30.0.10/32"
  store:
    engine: "sqlite"
    encryptionKey: "$(cat "$c/hitkit.nb.store-key")"
YAML
