# Proxmox VE 9 no-subscription repository, enabled by default so the machine can be
# updated in place without a subscription. The enterprise one is in pve-enterprise.sources,
# disabled; both can be switched in the web UI (Node > Updates > Repositories).
Types: deb
URIs: http://download.proxmox.com/debian/pve
Suites: trixie
Components: pve-no-subscription
Signed-By: /usr/share/keyrings/proxmox-archive-keyring.gpg
