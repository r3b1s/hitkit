#!/bin/sh
# Language-ecosystem caches are installed from their registries at image build
# time, pinned by version (bumping a version here rebuilds the image). Prepare
# scripts have network access; postinst scripts do not.
set -e
# verdaccio 6.8.0 is the newest release that supports Debian 13's Node.js 20.
[ "${1:-final}" = "final" ] || exit 0
python3 -m venv /opt/proxpi
/opt/proxpi/bin/pip install --no-cache-dir --quiet "proxpi==1.3.0" "gunicorn==23.0.0"
npm install --global --omit=dev --no-fund --no-audit "verdaccio@6.8.0" >/dev/null
