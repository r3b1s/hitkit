[Unit]
Description=Run exactly one Forgejo Actions job on this VM, then power off
After=docker.service hitkit-provision.service network-online.target
Wants=docker.service network-online.target
ConditionPathExists=/run/hitkit/ephemeral
SuccessAction=poweroff
FailureAction=poweroff

[Service]
Type=oneshot
User=runner
Group=runner
WorkingDirectory=/srv/data/runner
Environment=HOME=/home/runner
LoadCredential=hitkit.runner.token
LoadCredential=hitkit.runner.uuid
LoadCredential=hitkit.runner.handle
# The runner reaches the forge by the address its name has when the job starts. A job
# that runs hitkit nested (hitkit's own local CI) maps forgejo.hitkit.internal to its own
# forge in /etc/hosts, which must not take this runner with it. The forge's certificate
# covers its IP address too. If the name does not resolve, the name is used as before.
ExecStart=/bin/sh -c 'forge=$(getent ahostsv4 forgejo.hitkit.internal | head -n1 | cut -d" " -f1); exec /usr/local/bin/forgejo-runner one-job --config /etc/forgejo-runner/config.yml --url "https://$${forge:-forgejo.hitkit.internal}/" --uuid "$(cat "$CREDENTIALS_DIRECTORY/hitkit.runner.uuid")" --token-url "file:$CREDENTIALS_DIRECTORY/hitkit.runner.token" --handle "$(cat "$CREDENTIALS_DIRECTORY/hitkit.runner.handle")"'
TimeoutStartSec=4h

[Install]
WantedBy=multi-user.target
